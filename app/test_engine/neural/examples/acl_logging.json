  "1": {
    "description": "Change logging for non-existing ACL",
    "1.1": {
      "type": "POST",
      "endpoint": "/acl/logging",
      "schema": {
        "proto": "ipv4",
        "acl_name": "non_existing_ACL",
        "logging": true
      },
      "errCode": -1,
      "httpCode": 500
    }
  },
